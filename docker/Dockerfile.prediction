FROM kevinoulai/erctl:base AS builder

COPY code/Energy-Aware-Entity-Resolution/requirements/for_entries/requirements-base.txt \
     code/Energy-Aware-Entity-Resolution/requirements/for_entries/requirements-prediction.txt \
     /app/requirements/for_entries/

RUN /opt/venv/bin/pip install --no-cache-dir \
    -r /app/requirements/for_entries/requirements-prediction.txt

FROM kevinoulai/erctl:base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY ./code/Energy-Aware-Entity-Resolution/pipeline/decision_making.py /app/pipeline/decision_making.py
COPY ./code/Energy-Aware-Entity-Resolution/pipeline/evaluation.py /app/pipeline/evaluation.py
COPY ./code/Energy-Aware-Entity-Resolution/models/similarity_graph.py /app/models/similarity_graph.py
COPY ./code/Energy-Aware-Entity-Resolution/models/embedding_model.py /app/models/embedding_model.py
