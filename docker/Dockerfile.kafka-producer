# Must be supplied via --build-arg (images.sh reads image-repository.conf); no default
# so a stale hardcoded username can't silently sneak back in.
ARG IMAGE_REPOSITORY
FROM ${IMAGE_REPOSITORY}:kafka

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		default-jdk-headless \
		maven \
	&& rm -rf /var/lib/apt/lists/*

COPY code/Energy-Aware-Entity-Resolution/services/dataStreamSimulator \
     /app/services/dataStreamSimulator

WORKDIR /app/services/dataStreamSimulator

# Resolve dependencies and build the Spring Boot jar at image build time.
RUN mvn -B -ntp -DskipTests clean package

WORKDIR /app
