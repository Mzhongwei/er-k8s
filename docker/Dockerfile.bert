# images.sh overrides this from image-repository.conf. The deliberately unavailable
# default keeps both FROM expressions syntactically valid for Dockerfile linting while
# still making an invocation that omits --build-arg fail instead of using a stale image.
ARG IMAGE_REPOSITORY=invalid.invalid/eaer
FROM ${IMAGE_REPOSITORY}:base AS builder

COPY code/Energy-Aware-Entity-Resolution/requirements/for_entries/requirements-base.txt \
     code/Energy-Aware-Entity-Resolution/requirements/for_entries/requirements-bert.txt \
     /app/requirements/for_entries/

RUN /opt/venv/bin/pip install --no-cache-dir \
        torch==2.5.1+cu121 \
        --extra-index-url https://download.pytorch.org/whl/cu121 \
    && /opt/venv/bin/pip install --no-cache-dir \
        -r /app/requirements/for_entries/requirements-bert.txt

FROM ${IMAGE_REPOSITORY}:base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

COPY ./code/Energy-Aware-Entity-Resolution/pipeline/bert_training.py /app/pipeline/bert_training.py
COPY ./code/Energy-Aware-Entity-Resolution/pipeline/bert_evaluation.py /app/pipeline/bert_evaluation.py
COPY ./code/Energy-Aware-Entity-Resolution/pipeline/bert_utils.py /app/pipeline/bert_utils.py
COPY ./code/Energy-Aware-Entity-Resolution/models/bert_model.py /app/models/bert_model.py
