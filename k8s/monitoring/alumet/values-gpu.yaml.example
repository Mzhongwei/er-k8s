# Second Alumet release: NVML-only collector for explicitly labelled GPU nodes.
# The primary `eaer-alumet` release continues to collect RAPL on every enabled node.
alumet-relay-server:
  enabled: false

influxdb2:
  enabled: false

alumet-relay-client:
  enabled: true
  hostPID: true
  # Same selector `erctl alumet start` applies; set here so the first install never lands
  # on a node without a GPU.
  nodeSelector:
    eaer.alumet/enabled: "true"
    eaer.alumet/gpu-enabled: "true"
  securityContext:
    privileged: true
  # The collector only reads NVML counters and must not reserve a GPU: with nvml enabled the
  # chart adds `nvidia.com/gpu: 1` unless this key is present, which would take the only GPU
  # of a node away from bert-training / bert-matching. 0 keeps the key without allocating.
  resources:
    limits:
      cpu: 500m
      memory: 512Mi   # 128Mi is OOM-killed when many workload Pods are tracked
      nvidia.com/gpu: 0
  # Without a device-plugin allocation, the NVIDIA container runtime exposes the GPUs through
  # these variables (honoured for this privileged container). `utility` is enough for NVML.
  env:
    NVIDIA_VISIBLE_DEVICES: all
    NVIDIA_DRIVER_CAPABILITIES: utility
  # Uncomment when nvidia is not the default containerd runtime on the GPU nodes
  # (`kubectl get runtimeclass`; k3s registers one named "nvidia").
  # runtimeClassName: nvidia
  # GPU nodes are commonly tainted nvidia.com/gpu; the collector no longer requests a GPU, so
  # it must tolerate the taint itself. `erctl alumet start` restricts it to nodes labelled
  # eaer.alumet/enabled=true and eaer.alumet/gpu-enabled=true.
  tolerations:
    - key: nvidia.com/gpu
      operator: Exists
      effect: NoSchedule
  plugins:
    k8s:
      enable: true
      poll_interval: 1s
    procfs:
      enable: false
    rapl:
      enable: false
    nvml:
      enable: true
      poll_interval: 1s
      flush_interval: 5s
      mode: full
    energyAttribution:
      enable: true
    relay_client:
      enable: true
      relay_server: eaer-alumet-alumet-relay-server
      buffer_timeout: 2s
