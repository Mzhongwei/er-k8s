apiVersion: apps/v1
kind: Deployment
metadata:
  name: manager
spec:
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: manager
  template:
    metadata:
      labels:
        app: manager
    spec:
      containers:
      - name: manager
        image: eaer-k8s:slim
        imagePullPolicy: Never
        command: ["python", "/app/main_distribution.py"]
        resources:
          limits:
            memory: "128Mi"
            cpu: "500m"
          requests:
            memory: "32Mi"
            cpu: "50m"
        ports:
        - containerPort: 8080