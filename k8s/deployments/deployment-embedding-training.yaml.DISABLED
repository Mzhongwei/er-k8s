apiVersion: apps/v1
kind: Deployment
metadata:
  name: embedding-training
spec:
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: embedding-training
  template:
    metadata:
      labels:
        app: embedding-training
    spec:
      containers:
      - name: embedding-training
        image: erctl:slim
        imagePullPolicy: Never
        command: ["python", "/scripts/embedding_training.py"]
        resources:
          limits:
            memory: "128Mi"
            cpu: "500m"
          requests:
            memory: "32Mi"
            cpu: "50m"
        ports:
        - containerPort: 8080
        volumeMounts:
        - name: scripts
          mountPath: /scripts
          readOnly: true
        - name: pipeline-embedding-claim
          mountPath: /pipeline
      volumes:
      - name: scripts
        configMap:
          name: embedding-training
          items:
          - key: embedding_training.py
            path: embedding_training.py
      - name: pipeline-embedding-claim
        persistentVolumeClaim:
          claimName: pipeline-embedding-claim